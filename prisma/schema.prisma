generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "mysql"
}
enum Role {
  CLIENT
  COACH
}
enum Metric {
  BODYWEIGHT_KG
  WAIST_CM
}
model User {
  id String @id @default(cuid())
  email String @unique @db.VarChar(191)
  passwordHash String? @db.VarChar(255)
  role Role @default(CLIENT)
  timeZone String @default("Africa/Lagos") @db.VarChar(64)
  createdAt DateTime @default(now())
  sessions Session[]
  observations Observation[]
  workouts Workout[]
  awards AchievementAward[]
}
model Session {
  tokenHash String @id @db.Char(64)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId,expiresAt])
}
model Observation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  metric Metric
  value Decimal @db.Decimal(8,3)
  measuredAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now())
  voidedAt DateTime?
  requestId String @db.Char(36)
  payloadHash String @db.Char(64)
  @@unique([userId,requestId])
  @@index([userId,metric,measuredAt,id])
}
model Exercise {
  id String @id
  name String
  variation String
  equipment String
  loadConvention String // TOTAL, PER_HAND, ADDED or ASSISTANCE; never infer across conventions.
  sets WorkoutSet[]
}
model Workout {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  prescriptionId String? // Stable scheduled-session ID, retained through rescheduling.
  scheduledAt DateTime?
  completedAt DateTime?
  sets WorkoutSet[]
  @@unique([userId,prescriptionId])
  @@index([userId,completedAt])
}
model WorkoutSet {
  id String @id @default(cuid())
  workoutId String
  workout Workout @relation(fields:[workoutId],references:[id],onDelete:Restrict)
  exerciseId String
  exercise Exercise @relation(fields:[exerciseId],references:[id],onDelete:Restrict)
  position Int
  loadKg Decimal @db.Decimal(9,4)
  reps Int
  isWarmup Boolean @default(false)
  isEstimated Boolean @default(false)
  performedAt DateTime
  @@unique([workoutId,position])
}
model AchievementGroup {
  id String @id
  name String @unique
  position Int
  definitions AchievementDefinition[]
}
model AchievementDefinition {
  id String @id
  groupId String
  group AchievementGroup @relation(fields:[groupId],references:[id])
  name String
  subtitle String
  threshold Decimal? @db.Decimal(14,8)
  unit String?
  ruleVersion Int @default(1)
  evaluationEnabled Boolean @default(false)
  repeatable Boolean @default(false)
  awards AchievementAward[]
}
model AchievementAward {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  definitionId String
  definition AchievementDefinition @relation(fields:[definitionId],references:[id])
  eventKey String @db.VarChar(191) // 'once' for one-time badges; source-event ID for repeatable records.
  evidence Json
  ruleVersion Int
  awardedAt DateTime @default(now())
  confirmedById String? // Future approval service must verify assigned coach and append audit evidence.
  @@unique([userId,definitionId,eventKey])
}
